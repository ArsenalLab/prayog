id PQL2Distance<data_t>::preprocessed_distance(PQScratch<data_t> &pq_scratch, const uint32_t n_ids,\n240 |                                                  std::vector<float> &dists_out)\n241 | {\n242 |     pq_dist_lookup(pq_scratch.aligned_pq_coord_scratch, n_ids, _num_chunks, pq_scratch.aligned_pqtable_dist_scratch,\n243 |                    dists_out);\n244 | }\n245 | \n246 | template <typename data_t> float PQL2Distance<data_t>::brute_force_distance(const float *query_vec, uint8_t *base_vec)\n247 | {\n248 |     float res = 0;\n249 |     for (size_t chunk = 0; chunk < _num_chunks; chunk++)\n250 |     {\n251 |         for (size_t j = _chunk_offsets[chunk]; j < _chunk_offsets[chunk + 1]; j++)\n252 |         {\n253 |             const float *centers_dim_vec = _tables_tr.get() + (256 * j);\n254 |             float diff = centers_dim_vec[base_vec[chunk]] - (query_vec[j]);\n255 |             res += diff * diff;\n256 |         }\n257 |     }\n258 |     return res;\n259 | }\n260 | \n261 | template <typename data_t>\n262 | void PQL2Distance<data_t>::prepopulate_chunkwise_distances(const float *query_vec, float *dist_vec)\n263 | {\n264 |     memset(dist_vec, 0, 256 * _num_chunks * sizeof(float));\n265 |     // chunk wise distance computation"}{"type":"tool_use","timestamp":"2026-09-02T15:37:13.544Z","tool_name":"execute_command","tool_id":"tooluse_f2TEnRqcfOeBs0jXEa8LXa","parameters":{"command":"grep -n \"void pq_dist_lookup\" /home/khushiid/DiskANN/src/pq.cpp | head -10"}}{"type":"tool_result","timestamp":"2026-09-02T15:37:13.544Z","tool_id":"tooluse_f2TEnRqcfOeBs0jXEa8LXa","status":"success","output":"375:void pq_dist_lookup(const uint8_t *pq_ids, const size_t n_pts, const size_t pq_nchunks, const float *pq_dists,\n415:void pq_dist_lookup(const uint8_t *pq_ids, const size_t n_pts, const size_t pq_nchunks, const float *pq_dists,"}{"type":"tool_use","timestamp":"2026-09-02T15:37:15.324Z","tool_name":"read_file","tool_id":"tooluse_Fhw9VZXslL9UcBwxe9FEyT","parameters":{"path":"src/pq.cpp","range":"375-415"}}{"type":"tool_result","timestamp":"2026-09-02T15:37:15.324Z","tool_id":"tooluse_Fhw9VZXslL9UcBwxe9FEyT","status":"success","output":"Contents of file src/pq.cpp:\n\n375 | void pq_dist_lookup(const uint8_t *pq_ids, const size_t n_pts, const size_t pq_nchunks, const float *pq_dists,\n376 |                     std::vector<float> &dists_out)\n377 | {\n378 | //_mm_prefetch((char*) dists_out, _MM_HINT_T0);\n379 | #if !defined(DISKANN_PLATFORM_AIX) && !defined(DISKANN_PLATFORM_ZLINUX)\n380 |     _mm_prefetch((char *)pq_ids, _MM_HINT_T0);\n381 |     _mm_prefetch((char *)(pq_ids + 64), _MM_HINT_T0);\n382 |     _mm_prefetch((char *)(pq_ids + 128), _MM_HINT_T0);\n383 | #endif\n384 |     dists_out.clear();\n385 |     dists_out.resize(n_pts, 0);\n386 | \n387 |     for (size_t chunk = 0; chunk < pq_nchunks; chunk++)\n388 |     {\n389 |         const float *chunk_dists = pq_dists + 256 * chunk;\n390 |         if (chunk < pq_nchunks - 1)\n391 |         {\n392 | #if !defined(DISKANN_PLATFORM_AIX) && !defined(DISKANN_PLATFORM_ZLINUX)\n393 |             _mm_prefetch((char *)(chunk_dists + 256), _MM_HINT_T0);\n394 | #endif\n395 |         }\n396 |         for (size_t idx = 0; idx < n_pts; idx++)\n397 |         {\n398 |             uint8_t pq_centerid = pq_ids[pq_nchunks * idx + chunk];\n399 |             dists_out[idx] += chunk_dists[pq_centerid];\n400 |         }\n401 |     }\n402 | }\n403 | \n404 | // Need to replace calls to these functions with calls to vector& based\n405 | // functions above\n406 | void aggregate_coords(const uint32_t *ids, const size_t n_ids, const uint8_t *all_coords, const size_t ndims,\n407 |                       uint8_t *out)\n408 | {\n409 |     for (size_t i = 0; i < n_ids; i++)\n410 |     {\n411 |         memcpy(out + i * ndims, all_coords + ids[i] * ndims, ndims * sizeof(uint8_t));\n412 |     }\n413 | }\n414 | \n415 | void pq_dist_lookup(const uint8_t *pq_ids, const size_t n_pts, const size_t pq_nchunks, const float *pq_dists,"}`pq_dist_lookup` with `std::vector<float>` does `dists_out.clear(); dists_out.resize(n_pts, 0)`. That's correct.

But the crash is in `InMemDataStore::get_distance` which does NOT resize - it uses `distances[i]` directly. The crash occurs when `_pq_data_store` is actually an `InMemDataStore` (which happens when PQ is disabled - see line 181: `_pq_data_store = _data_store`).

So when `_pq_data_store` is actually `_data_store` (= `InMemDataStore`), the `get_distance(ids, dists_out)` method doesn't resize `dists_out`. The fix is in `InMemDataStore::get_distance`:{"type":"tool_use","timestamp":"2026-09-02T15:37:19.732Z","tool_name":"read_file","tool_id":"tooluse_PthmaEqNrK52oGIk5XX0nR","parameters":{"path":"src/in_mem_data_store.cpp","range":"263-275"}}{"type":"tool_result","timestamp":"2026-09-02T15:37:19.732Z","tool_id":"tooluse_PthmaEqNrK52oGIk5XX0nR","status":"success","output":"Contents of file src/in_mem_data_store.cpp:\n\n263 | template <typename data_t>\n264 | void InMemDataStore<data_t>::get_distance(const data_t *preprocessed_query, const std::vector<location_t> &ids,\n265 |                                           std::vector<float> &distances, AbstractScratch<data_t> *scratch_space) const\n266 | {\n267 |     for (int i = 0; i < ids.size(); i++)\n268 |     {\n269 |         distances[i] = _distance_fn->calculate_distance(preprocessed_query, _data + ids[i] * _aligned_dim,\n270 |                                                         (uint32_t)this->_aligned_dim);\n271 |     }\n272 | }\n273 | \n274 | template <typename data_t> location_t InMemDataStore<data_t>::expand(const location_t new_size)\n275 | {"}The fix is to resize `distances` to `ids.size()` before writing. This matches the PQDataStore behavior:{"type":"tool_use","timestamp":"2026-09-02T15:37:24.304Z","tool_name":"apply_diff","tool_id":"tooluse_eJy2vE19lMpntMF98mwWK0","parameters":{"path":"src/in_mem_data_store.cpp","diff":"<<<<<<< SEARCH\n:start_line:263\n-------\ntemplate <typename data_t>\nvoid InMemDataStore<data_t>::get_distance(const data_t *preprocessed_query, const std::vector<location_t> &ids,\n                                          std::vector<float> &distances, AbstractScratch<data_t> *scratch_space) const\n{\n    for (int i = 0; i < ids.size(); i++)\n    {\n        distances[i] = _distance_fn->calculate_distance(preprocessed_query, _data + ids[i] * _aligned_dim,\n                                                        (uint32_t)this->_aligned_dim);\n    }\n}\n=======\ntemplate <typename data_t>\nvoid InMemDataStore<data_t>::get_distance(const data_t *preprocessed_query, const std::vector<location_t> &ids,\n                                          std::vector<float> &distances, AbstractScratch<data_t> *scratch_space) const\n{\n    distances.resize(ids.size());\n    for (size_t i = 0; i < ids.size(); i++)\n    {\n        distances[i] = _distance_fn->calculate_distance(preprocessed_query, _data + ids[i] * _aligned_dim,\n                                                        (uint32_t)this->_aligned_dim);\n    }\n}\n>>>>>>> REPLACE\n"}}{"type":"tool_result","timestamp":"2026-09-02T15:37:24.304Z","tool_id":"tooluse_eJy2vE19lMpntMF98mwWK0","status":"success","output":"Edited file: src/in_mem_data_store.cpp\n\nYou do not need to re-read the file, as you have seen all changes.\nProceed with the task using these changes as the new baseline.\n\nIf the user's edits have addressed part of the task or changed the requirements, adjust your approach accordingly.\n\nPatch of edit:\n\n<patch>\n@@ -263,9 +263,10 @@\n template <typename data_t>\n void InMemDataStore<data_t>::get_distance(const data_t *preprocessed_query, const std::vector<location_t> &ids,\n                                           std::vector<float> &distances, AbstractScratch<data_t> *scratch_space) const\n {\n-    for (int i = 0; i < ids.size(); i++)\n+    distances.resize(ids.size());\n+    for (size_t i = 0; i < ids.size(); i++)\n     {\n         distances[i] = _distance_fn->calculate_distance(preprocessed_query, _data + ids[i] * _aligned_dim,\n                                                         (uint32_t)this->_aligned_dim);\n     }\n\n</patch>\n\nMaking multiple related changes in a single apply_diff is more efficient. If other changes are needed in this file, please include them as additional SEARCH/REPLACE blocks."}Now rebuild and test the failing cas